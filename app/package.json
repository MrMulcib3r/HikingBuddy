{
  "name": "hikingbuddy",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "db:migrate:local": "wrangler d1 migrations apply hikingbuddy --local",
    "deploy": "wrangler d1 migrations apply hikingbuddy --remote --config wrangler.jsonc && wrangler deploy"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "^1.2.3",
    "@fontsource/barlow-condensed": "^5.2.8",
    "@fontsource/overpass": "^5.2.8",
    "@modelcontextprotocol/server": "^2.3.1",
    "agents": "^0.29.0",
    "hono": "^4.13.13",
    "jose": "^6.2.13",
    "lucide-react": "^1.48.0",
    "lz-string": "^1.5.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.64.0",
    "@cloudflare/workers-types": "^5.20261021.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "wrangler": "^4.151.3"
  }
}
