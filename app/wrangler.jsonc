// Cloudflare Workers config (PRD v33, FR-24). One Worker serves:
// - the static app (built by Vite into ./dist) and shared gearlist links (FR-18),
// - the server code in ./worker for /api (data), /auth (Google sign-in) and the MCP server
//   (/mcp with OAuth: /authorize, /oauth/*, /.well-known/*; PRD v33, FR-26).
// Cloudflare runs `npm run build`, then `npm run deploy` (D1 migrations + wrangler deploy).
// Nothing secret belongs here: the repo is public. Secrets go to `wrangler secret put` and
// locally to app/.dev.vars (git-ignored).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hikingbuddy",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-10-19",
  // global_fetch_strictly_public: needed by workers-oauth-provider to read an AI client's public
  // metadata document (Client ID Metadata Documents, FR-26).
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "not_found_handling": "single-page-application",
    // Only these paths reach the server code; everything else is a static file.
    "run_worker_first": ["/api/*", "/auth/*", "/mcp", "/mcp/*", "/authorize", "/oauth/*", "/.well-known/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hikingbuddy",
      // Not a secret: the id only works with Martin's Cloudflare account.
      "database_id": "3ab43250-5d69-4534-9231-98630f9e8428",
      "migrations_dir": "migrations"
    }
  ],
  // FR-26: the MCP server's OAuth clients, grants and tokens (workers-oauth-provider). Not a secret.
  "kv_namespaces": [{ "binding": "OAUTH_KV", "id": "e2930b20cf114f0284bda89f476a1315" }],
  // FR-24: 60 requests a minute per user / IP (worker/rateLimit.ts).
  "ratelimits": [
    {
      "name": "API_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 60, "period": 60 }
    }
  ],
  "vars": {
    // Google OAuth client id (public; Google Cloud Console → Credentials). Empty = sign-in off.
    "GOOGLE_CLIENT_ID": "811787571787-akqkd2dae59fu1dm2blvk8uvijl1rv4m.apps.googleusercontent.com"
  },
  // FR-25: daily cleanup at 03:00 UTC: history and soft-deleted things older than 30 days
  // (worker/index.ts, scheduled). Cron Triggers are part of the free plan.
  "triggers": { "crons": ["0 3 * * *"] },
  "workers_dev": true,
  "preview_urls": true,
  "observability": { "enabled": true }
}
